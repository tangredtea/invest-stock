# Required: at least 32 characters. Do not use known insecure defaults.
INVEST_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Optional web bind address. Default: :8081
INVEST_ADDR=:8081

# Optional K-line cache TTL. Valid Go duration in [1s,24h]. Default: 24h
INVEST_KLINE_TTL=24h

# Optional initial administrator. If either value is invalid, seeding is skipped.
INVEST_ADMIN_USERNAME=admin
INVEST_ADMIN_PASSWORD=replace-with-a-strong-password
